ormat (part of flatbuffers)","dependencies":[{"name":"flatbuffers","version>=":"23.5.26#1"}]},"msgpack":{"description":"Support for the msgpack format","dependencies":[{"name":"msgpack-c","version>=":"6.0.0"}]},"parquet":{"description":"Enable parquet support","dependencies":[{"name":"arrow","features":["parquet"],"version>=":"21.0.0"}]},"toml":{"description":"Support for the TOML format","dependencies":[{"name":"tomlplusplus","version>=":"3.4.0#1"}]},"ubjson":{"description":"Support for the UBJSON format","dependencies":[{"name":"jsoncons","version>=":"1.4.0"}]},"xml":{"description":"Support for the XML format","dependencies":[{"name":"pugixml","version>=":"1.15"}]},"yaml":{"description":"Support for the YAML format","dependencies":[{"name":"yaml-cpp","version>=":"0.8.0#1"}]},"yas":{"description":"Enable yas support","dependencies":[{"name":"yas","version>=":"7.1.0"}]}},"_id":"jZ7HAW62sqC0aT8a"}
